/* =====================
   PROJECTS
===================== */

.project-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 50px;
}

.project-heading > p {
  max-width: 400px;

  color: #64748b;
  line-height: 1.7;
}

.project-controls {
  display: flex;
  justify-content: space-between;
  align-items: center;

  gap: 20px;

  margin-bottom: 40px;
}

.filters {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.filter {
  padding: 9px 16px;

  background: white;

  border: 1px solid #cbd5e1;

  border-radius: 50px;

  color: #64748b;

  font-weight: 600;
}

.filter.active,
.filter:hover {
  background: #6366f1;
  color: white;
  border-color: #6366f1;
}

.search {
  width: 220px;

  padding: 11px 15px;

  border: 1px solid #cbd5e1;

  border-radius: 8px;

  outline: none;
}

.search:focus {
  border-color: #6366f1;
}

.projects-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 25px;
}

.project-card {
  overflow: hidden;

  background: white;

  border: 1px solid #e2e8f0;

  border-radius: 14px;

  transition: 0.3s;
}

.project-card:hover {
  transform: translateY(-7px);

  box-shadow:
    0 20px 45px rgba(15, 23, 42, 0.1);
}

.project-image {
  height: 200px;

  display: flex;
  align-items: center;
  justify-content: center;

  position: relative;

  color: white;
}

.project-number {
  position: absolute;

  top: 15px;
  left: 18px;

  font-size: 13px;
  font-weight: 800;

  opacity: 0.8;
}

.project-icon {
  font-size: 65px;
}

.project-body {
  padding: 25px;
}

.project-category {
  color: #6366f1;

  font-size: 11px;

  font-weight: 800;

  text-transform: uppercase;

  letter-spacing: 1px;
}

.project-body h3 {
  font-size: 22px;

  margin: 10px 0;
}

.project-body p {
  color: #64748b;

  line-height: 1.6;

  font-size: 14px;

  margin-bottom: 20px;
}

.technology-list {
  display: flex;
  gap: 7px;

  flex-wrap: wrap;

  margin-bottom: 20px;
}

.technology-list span {
  background: #f1f5f9;

  color: #475569;

  padding: 6px 9px;

  border-radius: 5px;

  font-size: 11px;

  font-weight: 700;
}

.view-project {
  border: none;

  background: transparent;

  color: #6366f1;

  font-weight: 800;

  padding: 0;
}

.empty {
  text-align: center;

  padding: 60px;

  color: #64748b;
}

/* =====================
   MODAL
===================== */

.modal-overlay {
  position: fixed;

  inset: 0;

  z-index: 2000;

  background: rgba(15, 23, 42, 0.7);

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 20px;
}

.modal {
  width: 100%;
  max-width: 650px;

  background: white;

  border-radius: 15px;

  overflow: hidden;

  position: relative;

  animation: modalIn 0.25s ease;
}

@keyframes modalIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

.close-modal {
  position: absolute;

  top: 15px;
  right: 15px;

  z-index: 2;

  width: 38px;
  height: 38px;

  border: none;

  border-radius: 50%;

  background: white;

  font-size: 25px;
}

.modal-image {
  height: 230px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: white;

  font-size: 80px;
}

.modal-content {
  padding: 35px;
}

.modal-content h2 {
  font-size: 32px;

  margin: 10px 0 15px;
}

.modal-content > p {
  color: #64748b;

  line-height: 1.7;

  margin-bottom: 25px;
}

.modal-content h4 {
  margin-bottom: 12px;
}

.modal-button {
  margin-top: 10px;
}

/* =====================
   CONTACT
===================== */

.contact-section {
  background: #f1f5f9;
}

.contact-grid {
  display: grid;

  grid-template-columns: 0.8fr 1.2fr;

  gap: 70px;
}

.contact-text h3 {
  font-size: 32px;

  margin-bottom: 20px;
}

.contact-text > p {
  color: #64748b;

  line-height: 1.8;

  margin-bottom: 35px;
}

.contact-details > div {
  display: flex;

  align-items: center;

  gap: 15px;

  margin-bottom: 20px;
}

.contact-details span {
  width: 45px;
  height: 45px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #e0e7ff;

  border-radius: 8px;
}

.contact-details p {
  color: #64748b;

  margin-top: 3px;
}

.contact-form {
  background: white;

  padding: 35px;

  border-radius: 14px;

  border: 1px solid #e2e8f0;
}

.contact-form label {
  display: block;

  font-weight: 700;

  margin-bottom: 8px;
}

.contact-form input,
.contact-form textarea {
  width: 100%;

  padding: 14px;

  border: 1px solid #cbd5e1;

  border-radius: 8px;

  outline: none;

  margin-bottom: 20px;

  resize: vertical;
}

.contact-form input:focus,
.contact-form textarea:focus {
  border-color: #6366f1;
}

.success {
  color: #059669;

  font-weight: 700;

  margin-top: 15px;
}

/* =====================
   FOOTER
===================== */

footer {
  background: #0f172a;

  color: #94a3b8;

  padding: 45px 25px;

  text-align: center;
}

.footer-container h3 {
  color: white;

  font-size: 22px;

  margin-bottom: 10px;
}

.footer-container h3 span {
  color: #6366f1;
}

.footer-container p {
  font-size: 14px;
}

.copyright {
  margin-top: 20px;

  color: #64748b;
}

/* =====================
   DARK MODE
===================== */

.dark {
  background: #0f172a;
  color: #f8fafc;
}

.dark .navbar {
  background: rgba(15, 23, 42, 0.9);

  border-color: #1e293b;
}

.dark .nav-links a {
  color: #cbd5e1;
}

.dark .hero {
  background:
    radial-gradient(
      circle at 90% 10%,
      #312e81,
      transparent 35%
    );
}

.dark .hero-content > p,
.dark .about-text p,
.dark .project-heading > p,
.dark .project-body p,
.dark .contact-text > p {
  color: #94a3b8;
}

.dark .section-title h2,
.dark .about-text h3,
.dark .contact-text h3 {
  color: white;
}

.dark .skills-section,
.dark .contact-section {
  background: #111827;
}

.dark .info-card,
.dark .skill-card,
.dark .project-card,
.dark .contact-form {
  background: #1e293b;

  border-color: #334155;
}

.dark .info-card p,
.dark .skill-card p {
  color: #94a3b8;
}

.dark .technology-list span {
  background: #334155;
  color: #cbd5e1;
}

.dark .search {
  background: #1e293b;

  color: white;

  border-color: #475569;
}

.dark .filter {
  background: #1e293b;

  color: #cbd5e1;

  border-color: #475569;
}

.dark .filter.active {
  background: #6366f1;
  color: white;
}

.dark .contact-form input,
.dark .contact-form textarea {
  background: #0f172a;

  color: white;

  border-color: #475569;
}

.dark .outline {
  background: #1e293b;
}

.dark .modal {
  background: #1e293b;

  color: white;
}

/* =====================
   TABLET
===================== */

@media (max-width: 950px) {

  .hero-container {
    grid-template-columns: 1fr;

    text-align: center;
  }

  .hero-content > p {
    margin: auto;
  }

  .available {
    margin-left: auto;
    margin-right: auto;
  }

  .hero-buttons,
  .hero-stats {
    justify-content: center;
  }

  .about-grid {
    grid-template-columns: 1fr;
  }

  .skills-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .projects-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .contact-grid {
    grid-template-columns: 1fr;
  }

  .project-heading {
    align-items: start;
    flex-direction: column;
  }
}

/* =====================
   MOBILE
===================== */

@media (max-width: 650px) {

  .nav-container {
    padding: 15px 20px;
  }

  .mobile-menu {
    display: block;
  }

  .nav-links {
    display: none;

    position: absolute;

    left: 0;
    top: 70px;

    width: 100%;

    padding: 25px;

    flex-direction: column;

    background: white;

    border-bottom: 1px solid #e2e8f0;
  }

  .dark .nav-links {
    background: #0f172a;

    border-color: #1e293b;
  }

  .nav-links.active {
    display: flex;
  }

  .hero-container {
    padding: 70px 20px;
  }

  .hero h1 {
    font-size: 43px;

    letter-spacing: -2px;
  }

  .hero-buttons {
    flex-direction: column;
  }

  .hero-buttons .btn {
    width: 100%;
  }

  .hero-stats {
    gap: 20px;
  }

  .hero-stats strong {
    font-size: 21px;
  }

  .code-content {
    padding: 25px;

    font-size: 12px;
  }

  .section {
    padding: 75px 20px;
  }

  .section-title h2 {
    font-size: 36px;
  }

  .about-cards {
    grid-template-columns: 1fr;
  }

  .skills-grid,
  .projects-grid {
    grid-template-columns: 1fr;
  }

  .project-controls {
    flex-direction: column;
    align-items: stretch;
  }

  .search {
    width: 100%;
  }

  .contact-form {
    padding: 25px;
  }

  .modal-content {
    padding: 25px;
  }

  .modal-image {
    height: 180px;
  }
}
